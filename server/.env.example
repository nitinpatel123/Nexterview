PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=your_mongodb_atlas_connection_string

# JWT
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRE=7d

# Groq AI (get free key at console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Judge0 - for real code execution in coding tests
# Default: self-hosted via Docker (free, no billing) at http://localhost:2358
# Leave JUDGE0_API_KEY blank to use self-hosted. Only fill it in if you
# switch to RapidAPI's paid hosted Judge0 CE instead.
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# Cloudinary (for certificate/resume uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (optional) - for "Forgot Password" reset emails
# Leave blank to run locally without real email — the reset link will
# instead be printed to this server's terminal so you can still test it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
